# ==========================================
# EquiTraffic-GPT Git Ignore Configuration
# ==========================================

# ------------------------------------------
# Python
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Python packaging / build artifacts
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------
# Virtual Environments
# ------------------------------------------
venv/
.venv/
env/
ENV/

# ------------------------------------------
# Machine Learning Model Files
# ------------------------------------------
*.pt
*.pth
*.ckpt
*.h5
*.onnx
*.bin

# Keep model registry manifest tracked
!model_registry.json

# ------------------------------------------
# Node.js / React
# ------------------------------------------
node_modules/
**/node_modules/

dist/
**/dist/

.vite/
**/.vite/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------
# Environment Variables / Secrets
# ------------------------------------------
.env
.env.*
!.env.example

# ------------------------------------------
# Logs
# ------------------------------------------
*.log
*.out
*.err

# ------------------------------------------
# Temporary / Generated Files
# ------------------------------------------
result.json
.system_generated/
scratch/
temp/
tmp/

*.tmp
*.bak
*.cache

# ------------------------------------------
# Python Testing / Tool Caches
# ------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ------------------------------------------
# Jupyter
# ------------------------------------------
.ipynb_checkpoints/

# ------------------------------------------
# IDE
# ------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# ------------------------------------------
# Operating System
# ------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ------------------------------------------
# Frontend / Build Caches
# ------------------------------------------
.cache/
.parcel-cache/
.turbo/

# ------------------------------------------
# Local Development Data
# ------------------------------------------
*.sqlite
*.sqlite3
# ==========================================
# EquiTraffic-GPT Git Ignore Configuration (.gitignore)
# ==========================================

# 🐍 Python & Byte-compiled / Optimized Files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ⚡ PyTorch & Neural Network Model Checkpoints
*.pt
*.pth
*.ckpt
*.h5
*.onnx
*.bin
# Keep registry manifest tracked
!model_registry.json

# 💻 Node.js & React Frontend (traffic-system-web)
node_modules/
traffic-system-web/node_modules/
traffic-system-web/dist/
traffic-system-web/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 🔑 Virtual Environments & Secrets
venv/
.venv/
env/
ENV/
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 📊 System Logs & Temporary Artifacts
*.log
result.json
.system_generated/
scratch/
temp/
tmp/

# 🛠️ IDE & Operating System Specific Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
